class _RingPainter extends CustomPainter {
  const _RingPainter({
    required this.progress,
    required this.dotProgress,
    required this.orange,
  });

  final double progress;
  final double dotProgress;
  final Color orange;

  @override
  void paint(Canvas canvas, Size size) {
    final center = size.center(Offset.zero);
    final radius = size.width * 0.37;

    final ringPaint = Paint()
      ..color = orange.withValues(alpha: 0.90)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 3.0
      ..strokeCap = StrokeCap.round;

    final rect = Rect.fromCircle(center: center, radius: radius);

    // Starts at 12 o'clock and draws clockwise.
    canvas.drawArc(
      rect,
      -math.pi / 2,
      math.pi * 2 * progress,
      false,
      ringPaint,
    );

    if (dotProgress > 0) {
      final angle = -math.pi / 2 + (math.pi * 2 * dotProgress);
      final dot = Offset(
        center.dx + math.cos(angle) * radius,
        center.dy + math.sin(angle) * radius,
      );

      final glowPaint = Paint()
        ..color = orange.withValues(alpha: 0.22)
        ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 9);

      canvas.drawCircle(dot, 9, glowPaint);
      canvas.drawCircle(dot, 4.6, Paint()..color = orange);
    }
  }

  @override
  bool shouldRepaint(covariant _RingPainter oldDelegate) {
    return oldDelegate.progress != progress ||
        oldDelegate.dotProgress != dotProgress;
  }
}

class _RoadPainter extends CustomPainter {
  const _RoadPainter({
    required this.progress,
    required this.glow,
    required this.orange,
    required this.green,
  });

  final double progress;
  final double glow;
  final Color orange;
  final Color green;

  @override
  void paint(Canvas canvas, Size size) {
    if (progress <= 0) return;

    final path = Path()
      ..moveTo(size.width * 0.18, size.height)
      ..cubicTo(
        size.width * 0.28,
        size.height * 0.63,
        size.width * 0.70,
        size.height * 0.72,
        size.width * 0.52,
        size.height * 0.18,
      );

    final metric = path.computeMetrics().first;
    final visible = metric.extractPath(0, metric.length * progress);

    final glowPaint = Paint()
      ..color = orange.withValues(alpha: 0.16 + 0.22 * glow)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 12
      ..strokeCap = StrokeCap.round
      ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 12);

    final linePaint = Paint()
      ..color = orange.withValues(alpha: 0.72)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 3
      ..strokeCap = StrokeCap.round;

    canvas.drawPath(visible, glowPaint);
    canvas.drawPath(visible, linePaint);

    if (progress > 0.84) {
      final pinOpacity = ((progress - 0.84) / 0.16).clamp(0.0, 1.0);
      final pinPoint = metric.getTangentForOffset(metric.length)?.position;

      if (pinPoint != null) {
        canvas.drawCircle(
          pinPoint,
          10,
          Paint()..color = green.withValues(alpha: pinOpacity),
        );
        canvas.drawCircle(
          pinPoint,
          4,
          Paint()..color = Colors.white.withValues(alpha: pinOpacity),
        );
      }
    }
  }

  @override
  bool shouldRepaint(covariant _RoadPainter oldDelegate) {
    return oldDelegate.progress != progress || oldDelegate.glow != glow;
  }
}
